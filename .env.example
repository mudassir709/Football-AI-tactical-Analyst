# Copy this file to ".env" and fill in real values. ".env" is never committed.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=tactical
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tactical_analyst
DATABASE_URL=postgresql://tactical:change-me@localhost:5432/tactical_analyst

# --- Redis (job queue) --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Backend API --------------------------------------------------------------
API_PORT=4000
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Where uploaded videos and analysis results are stored (shared with the worker).
STORAGE_DIR=./storage
# Address of the React dev server, allowed to call the API.
FRONTEND_URL=http://localhost:5173

# --- LLM coaching reports -----------------------------------------------------
ANTHROPIC_API_KEY=
