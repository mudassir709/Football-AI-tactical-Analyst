# Copy this file to ".env" and fill in real values. ".env" is never committed.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=tactical
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tactical_analyst
DATABASE_URL=postgresql://tactical:change-me@localhost:5432/tactical_analyst

# --- Redis (job queue) --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Backend API --------------------------------------------------------------
API_PORT=4000
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Where uploaded videos and analysis results are stored (shared with the worker).
STORAGE_DIR=./storage
# Address of the React dev server, allowed to call the API.
FRONTEND_URL=http://localhost:5173

# --- Optional cloud GPU analysis service (see docs/how-it-works/05-cloud-gpu.md)
# Leave GPU_SERVER_URL empty to analyse on this machine only. When set, the
# worker sends videos to the GPU service and falls back to local analysis if
# it cannot be reached. Restart the worker after changing these.
GPU_SERVER_URL=
# Shared secret; the GPU service must be started with the same value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GPU_SERVER_TOKEN=

# --- LLM coaching reports -----------------------------------------------------
# Azure OpenAI (Azure portal -> your Azure OpenAI / Foundry resource -> "Keys and
# Endpoint"; the deployment name is the one you chose when deploying a model).
# Leave empty to disable reports. Restart the backend after changing these.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Optional; the default (2025-04-01-preview) supports current GPT and o-series models.
AZURE_OPENAI_API_VERSION=
