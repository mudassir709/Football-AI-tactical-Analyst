%% ==== sequence_upload
sequenceDiagram
  autonumber
  actor U as User
  participant B as Browser (React)
  participant A as API (Express)
  participant D as PostgreSQL
  participant Q as Redis queue
  participant W as AI worker
  U->>B: choose video,<br/>title, mode
  B->>A: POST /api/matches<br/>(multipart)
  A->>A: check extension, type,<br/>size, file signature
  A->>D: INSERT match<br/>(QUEUED)
  A->>Q: add job {matchId,<br/>videoPath, mode}
  A-->>B: 201 Created<br/>{match}
  B->>A: WebSocket connect<br/>(login cookie)
  Q->>W: job becomes<br/>active
  Q-->>A: event "active"
  A->>D: status =<br/>PROCESSING
  A-->>B: match:updated

%% ==== sequence_progress
sequenceDiagram
  autonumber
  actor U as User
  participant B as Browser (React)
  participant A as API (Express)
  participant D as PostgreSQL
  participant Q as Redis queue
  participant W as AI worker
  loop every stage of the pipeline
    W->>Q: updateProgress<br/>{percent, stage}
    Q-->>A: event "progress"
    A->>D: progress, stage
    A-->>B: match:updated<br/>(progress bar moves)
  end
  W->>W: write results JSON,<br/>H.264 copy, "done" note
  W->>Q: return {resultPath,<br/>playbackPath, summary}
  Q-->>A: event "completed"
  A->>D: status = COMPLETED,<br/>summary
  A-->>B: match:updated
  B->>A: GET /results and /video<br/>(Range requests)
  B->>U: video with<br/>synchronised overlays

