%% ==== architecture
flowchart TB
  subgraph Client["Client (web browser)"]
    UI["React dashboard<br/>upload · overlays · 2D board · report"]
  end
  subgraph Server["Application server"]
    NGINX["nginx<br/>static files + reverse proxy"]
    API["Node.js API (Express 5)<br/>auth · uploads · jobs · cancel · Socket.IO"]
    DB[("PostgreSQL 17<br/>users · matches")]
    Q[("Redis 7.4<br/>BullMQ job queue · cancel notes")]
    FS[["Shared file storage<br/>videos/ · results/"]]
    W["Python AI worker<br/>YOLOv8 · ByteTrack · homography · clean-up<br/>K-Means · formations · positions · metrics"]
  end
  GPU["Cloud GPU service<br/>(optional, RunPod)"]
  LLM["Azure OpenAI<br/>(coaching report)"]
  UI -- "HTTP: REST + WebSocket" --> NGINX --> API
  API --> DB
  API -- "add job / job events" --> Q
  Q -- "take job / progress" --> W
  API --> FS
  W --> FS
  W -. "offload analysis" .-> GPU
  API -. "statistics only" .-> LLM

