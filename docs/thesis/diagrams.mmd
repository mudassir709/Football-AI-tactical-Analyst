    Json summary "nullable, headline numbers"
    String report "nullable, Markdown"
    DateTime createdAt
    DateTime updatedAt
    DateTime completedAt "nullable"
  }

%% ==== status
stateDiagram-v2
  direction LR
  [*] --> QUEUED: upload accepted
  QUEUED --> PROCESSING: worker takes the job
  PROCESSING --> COMPLETED: results written
  PROCESSING --> QUEUED: error, retry left
  PROCESSING --> FAILED: error on last attempt
  COMPLETED --> QUEUED: Re-analyse
  FAILED --> QUEUED: Re-analyse
  COMPLETED --> [*]: Delete
  FAILED --> [*]: Delete
  QUEUED --> [*]: Delete

%% ==== pipeline
flowchart TB
  V[/"Uploaded video"/] --> T["0 · H.264 playback copy<br/>PyAV / libx264 · 0–5 %"]
  T --> DT["1 · Detection + tracking · 5–60 %<br/>YOLOv8x: ball, goalkeeper, player, referee<br/>ByteTrack IDs · best ball per frame"]
  DT --> KP["2 · Pitch keypoints · 60–88 %<br/>YOLOv8-pose, 32 landmarks"]
  KP --> H["Homography per frame<br/>RANSAC · collinearity check · reuse ≤ 10 frames"]
  H --> P["Project feet → pitch metres (105 × 68 m)"]
  P --> TA["3 · Team assignment · 88–93 %<br/>torso colour vs local grass (Lab)<br/>K-Means k = 2 · goalkeepers by proximity"]
  TA --> S["4 · Tactics · 93–98 %<br/>smoothing (1 s) · ball gap interpolation"]
  S --> F["Formations<br/>5 s windows · Hungarian matching · hysteresis"]
  S --> M["Metrics<br/>convex-hull area · width · depth<br/>distance · speed · heatmaps"]
  F --> R[/"5 · results JSON, atomic write · 98–100 %"/]
  M --> R
  R --> SUM[/"summary → database"/]

