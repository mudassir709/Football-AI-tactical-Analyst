%% ==== gpu_sequence
sequenceDiagram
  autonumber
  participant W as Worker
  participant G as GPU service (FastAPI)
  W->>G: GET /health (Bearer token)
  alt unreachable or server error
    W->>W: RemoteUnavailable, run pipeline locally
  else available
    W->>G: POST /jobs (video, mode)
    G-->>W: {id}
    loop every few seconds
      W->>G: GET /jobs/{id}
      G-->>W: {status, percent, stage}
      W->>W: forward progress to the queue
    end
    W->>G: GET /jobs/{id}/results and /playback
    W->>G: DELETE /jobs/{id}
  end

%% ==== classes_worker
classDiagram
  direction LR
  class FootballDetector {
    +imgsz: int
    +detect_batch(frames) list
    -_postprocess(result) Detections
  }
  class FootballTracker {
    +update(detections, timestamp) tuple
    +reset()
    -_select_ball(balls) Detections
  }
  class PitchKeypointDetector {
    +detect_batch(frames) list
  }
  class HomographyEstimator {
    +max_reuse: int
    +update(xy, confidence) tuple
    +reset()
  }
  class Homography {
    +matrix: ndarray 3x3
    +n_inliers: int
    +reprojection_error: float
    +fit(image_points, pitch_points)$ Homography
    +image_to_pitch(points) ndarray
  }
  class PitchDimensions {
    +length: float = 105
    +width: float = 68
    +keypoints: ndarray 32x2
    +line_segments() list
  }
  class TeamAssignment {
    +track_teams: dict
    +team_colours_bgr: ndarray
    +agreement: Series
    +team_colour_hex(team) str
  }
  class FormationResult {
    +windows: DataFrame
    +positions: DataFrame
    +changes: DataFrame
  }
  HomographyEstimator --> Homography : creates
  HomographyEstimator --> PitchDimensions : uses
  FootballTracker ..> FootballDetector : consumes detections

